{
  "name": "@evolv/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./alerts": {
      "types": "./dist/core/alerts.d.ts",
      "default": "./dist/core/alerts.js"
    },
    "./billing": {
      "types": "./dist/core/billing.d.ts",
      "default": "./dist/core/billing.js"
    },
    "./brief": {
      "types": "./dist/core/brief.d.ts",
      "default": "./dist/core/brief.js"
    },
    "./dates": {
      "types": "./dist/core/dates.d.ts",
      "default": "./dist/core/dates.js"
    },
    "./evm": {
      "types": "./dist/core/evm.d.ts",
      "default": "./dist/core/evm.js"
    },
    "./format": {
      "types": "./dist/core/format.d.ts",
      "default": "./dist/core/format.js"
    },
    "./labour": {
      "types": "./dist/core/labour.d.ts",
      "default": "./dist/core/labour.js"
    },
    "./resources": {
      "types": "./dist/core/resources.d.ts",
      "default": "./dist/core/resources.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/domain.d.ts"
      ],
      "ports": [
        "dist/ports/index.d.ts"
      ],
      "alerts": [
        "dist/core/alerts.d.ts"
      ],
      "billing": [
        "dist/core/billing.d.ts"
      ],
      "brief": [
        "dist/core/brief.d.ts"
      ],
      "dates": [
        "dist/core/dates.d.ts"
      ],
      "evm": [
        "dist/core/evm.d.ts"
      ],
      "format": [
        "dist/core/format.d.ts"
      ],
      "labour": [
        "dist/core/labour.d.ts"
      ],
      "resources": [
        "dist/core/resources.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
